#version 450
#extension GL_GOOGLE_include_directive : require
// Sums dense_partial chunks into the gradient vector.
layout(local_size_x = 256) in;
#include "common.glsl"

void main() {
    const uint w = pc.width, n = 17 * w + 8, stride = n;
    for (uint i = gl_GlobalInvocationID.x; i < n; i += gl_NumWorkGroups.x * 256) {
        float s = 0.0;
        for (uint c = 0; c < pc.chunks; ++c)
            s += SCRATCH[c * stride + i];
        uint dest;
        if (i < 16 * w)
            dest = pc.direct_w + i;
        else if (i < 17 * w)
            dest = pc.ft_bias + (i - 16 * w);
        else
            dest = pc.direct_b + (i - 17 * w);
        G[dest] = s;
    }
}
